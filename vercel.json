{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/car-parts/product/:slug",
      "destination": "/products/product/:slug",
      "permanent": true
    },
    {
      "source": "/heavy-truck-parts/product/:slug",
      "destination": "/products/product/:slug",
      "permanent": true
    },
    {
      "source": "/car-parts/:category",
      "destination": "/products?category=:category",
      "permanent": true
    },
    {
      "source": "/heavy-truck-parts/:category",
      "destination": "/products?category=:category",
      "permanent": true
    },
    {
      "source": "/car-parts",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/heavy-truck-parts",
      "destination": "/products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
